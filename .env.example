# Copy to .env for local development (auto-loaded on startup). Everything here is
# optional except PUBMED_EMAIL + ANTHROPIC_API_KEY (needed for the live free-tier
# card). Never commit your real .env.

# --- PubMed retrieval (NCBI E-utilities) ---
# Contact email required by NCBI's usage policy. Needed for /random and /search.
PUBMED_EMAIL=your-email@example.com
# Optional NCBI API key: raises the rate limit from 3 to 10 req/s.
# NCBI_API_KEY=
NCBI_TOOL=PaperBytes
PUBMED_PAGE_SIZE=100
PUBMED_TIMEOUT_SECONDS=20
LOOKBACK_DAYS=7

# --- Anthropic (AI summary + critical appraisal) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5
# Set to 1 to fill appraisals from article metadata instead of calling Anthropic
# (demo/design without spending credits).
MOCK_ANALYSIS=0

# --- OpenAI (AI card illustrations, gpt-image-1) ---
# Optional. Without a key the card shows the "Your hero is coming!" placeholder.
OPENAI_API_KEY=sk-proj-...
IMAGE_QUALITY=medium   # low | medium | high

# --- Contact form ---
# Destination for contact messages — server-side only, never sent to the browser.
# Without SMTP creds, messages are stored in the contact_messages table.
CONTACT_EMAIL=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-16-char-gmail-app-password

# --- Storage ---
# Defaults to a local SQLite file. Point at Postgres for deployment; a legacy
# postgres:// URL is normalised to postgresql:// automatically.
# DATABASE_URL=postgresql://user:pass@host:5432/paperbytes
# DATABASE_URL=sqlite:///./paperbytes.db

# --- Server / logging ---
# LOG_LEVEL=INFO
# PORT=8000
# RELOAD=1   # uvicorn auto-reload when running `python main.py`
