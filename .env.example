# Copy to .env for local development (auto-loaded on startup).

# --- NCBI / PubMed retrieval ---
# PUBMED_EMAIL is the contact address NCBI's usage policy requires. Needed by the
# /search and /fetch endpoints; the read endpoints (/articles, /specialties) boot
# and work without it.
PUBMED_EMAIL=your-email@example.com
# Optional NCBI E-utilities API key. With a key the client is allowed 10 req/s
# instead of 3. Get one at https://www.ncbi.nlm.nih.gov/account/ (Settings -> API
# Key Management). Never commit a real key.
# NCBI_API_KEY=
# Identifies the client to NCBI (also required by their policy).
NCBI_TOOL=PaperBytes
# EFetch/ESearch page size and the threshold for history-server paging.
PUBMED_PAGE_SIZE=100
PUBMED_TIMEOUT_SECONDS=20

# --- Anthropic / summarisation ---
# Required by the /fetch endpoints (summarisation). Not needed for /search.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5

# --- Fetch window ---
LOOKBACK_DAYS=7

# --- Storage ---
# Defaults to a local SQLite file when unset — no setup needed. Point at Postgres
# when you containerise for deployment, e.g.
# DATABASE_URL=postgresql://user:pass@localhost:5432/paperbytes
# DATABASE_URL=sqlite:///./paperbytes.db

# --- Server / logging ---
# LOG_LEVEL=INFO
# Set RELOAD=1 to enable auto-reload when running `python main.py`.
# RELOAD=1
