# Copy to .env for local development (auto-loaded on startup).

# Required only for the /fetch endpoints; read endpoints work without them.
PUBMED_EMAIL=your-email@example.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional.
CLAUDE_MODEL=claude-haiku-4-5
LOOKBACK_DAYS=7

# Storage. Defaults to a local SQLite file when unset — no setup needed.
# Point this at Postgres when you containerise for deployment, e.g.
# DATABASE_URL=postgresql://user:pass@localhost:5432/paperbytes
# DATABASE_URL=sqlite:///./paperbytes.db

# Set RELOAD=1 to enable auto-reload when running `python main.py`.
# RELOAD=1
